  <ThingDef ParentName="AoOni_EntityBase">
    <defName>AoOni_AoOni</defName>
    <uiIconPath>Things/Entity/AoOni_north</uiIconPath>
    <label>Ao Oni</label>
    <description>A colossal humanoid with bluish skin and an enormous unblinking head. It moves at a slow, relentless walk, and its bite and claws tear through flesh with terrible ease.\n\nThose wounded by an Ao Oni become infected. Three days later, they become an Oni themselves.</description>
    <statBases>
      <MoveSpeed>5.0</MoveSpeed>
    </statBases>
    <race>
      <renderTree>AoOniTree_AoOni</renderTree>
      <baseHealthScale>2</baseHealthScale>
    </race>
  </ThingDef>

